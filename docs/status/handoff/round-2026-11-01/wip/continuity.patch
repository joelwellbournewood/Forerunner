+    await rt?.close();
+  });
+
+  it("the stop files one card; the result, the Tasks tab and the Inbox agree, in CHF", async () => {
+    const started = await req("/sessions", {
+      method: "POST",
+      body: JSON.stringify({ agentId: rt.agent.id, projectId, trigger: "manual" }),
+    });
