{
  "name": "@forerunner/ui",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "The one React UI for desktop (Windows, Linux) and Android, built with Vite and Tailwind.",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 1420",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0",
    "uqr": "0.1.2",
    "zod": "^4.6.7",
    "@forerunner/runtime": "workspace:*",
    "@forerunner/vault": "workspace:*"
  },
  "devDependencies": {
    "@forerunner/platform": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0 5.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0",
    "hono": "^4.13.13",
    "@hono/node-server": "^2.1.5"
  }
}
