{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Forerunner",
  "version": "1.0.4",
  "identifier": "app.forerunner.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @forerunner/ui dev",
    "beforeBuildCommand": "pnpm --filter @forerunner/ui build && pnpm -w run runtime:payload"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage", "deb"],
    "resources": {
      "runtime/": "runtime/"
    },
    "windows": {
      "wix": {
        "version": "1.0.4"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["fr"]
      }
    }
  }
}
