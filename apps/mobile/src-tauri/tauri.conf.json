{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Forerunner",
  "version": "0.1.0",
  "identifier": "app.forerunner.mobile",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @forerunner/ui dev",
    "beforeBuildCommand": "pnpm --filter @forerunner/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Forerunner",
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29
    }
  },
  "plugins": {}
}
