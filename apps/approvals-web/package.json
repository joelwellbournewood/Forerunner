{
  "name": "@forerunner/approvals-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web fallback for approvals and chat, served by the state service.",
  "scripts": {
    "dev": "vite --port 1430 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0 5.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0"
  }
}
