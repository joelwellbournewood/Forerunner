{
  "version": 1,
  "entries": [
    {
      "id": "browser",
      "kind": "capability",
      "name": "browser",
      "description": "Sandboxed browser (Playwright, isolated profile per agent). Site allowlist per project; purchases and credential entry always need approval.",
      "version": "1.0.0",
      "module": "@forerunner/capabilities/browser",
      "permissions": {
        "tools": [
          "browser_navigate",
          "browser_read",
          "browser_click",
          "browser_type",
          "browser_fill_secret",
          "browser_screenshot",
          "browser_download",
          "browser_close"
        ],
        "actionClasses": ["read", "routine_reversible", "credential"],
        "domains": [],
        "paths": [],
        "secrets": [],
        "scopes": ["browse allowlisted sites in an isolated profile", "screenshots are logged"]
      },
      "tags": ["web"]
    },
    {
      "id": "email",
      "kind": "capability",
      "name": "email",
      "description": "The agent's own mailbox (never the human's). Mode per agent: off, read only, draft only, allowlist, full discretion; daily and per-recipient caps always on.",
      "version": "1.0.0",
      "module": "@forerunner/capabilities/email",
      "permissions": {
        "tools": ["email_list", "email_read", "email_draft", "email_send"],
        "actionClasses": ["read", "routine_reversible", "external_send"],
        "domains": [],
        "paths": [],
        "secrets": ["agent_mailbox_password"],
        "scopes": ["read the agent mailbox", "send within the mode and caps set in Settings"]
      },
      "tags": ["mail"]
    },
    {
      "id": "desktop-control",
      "kind": "capability",
      "name": "desktop-control",
      "description": "Desktop control: off by default, needs autonomy 3+, per-app allowlist, visible on-screen indicator while active, screenshots logged.",
      "version": "1.0.0",
      "module": "@forerunner/capabilities/desktop",
      "requiresAutonomy": 3,
      "permissions": {
        "tools": [
          "desktop_list_windows",
          "desktop_focus",
          "desktop_type",
          "desktop_key",
          "desktop_click",
          "desktop_screenshot"
        ],
        "actionClasses": ["read", "non_routine"],
        "domains": [],
        "paths": [],
        "secrets": [],
        "scopes": [
          "list, focus, type into, send keys to and click in applications on your desktop allowlist",
          "screenshots of the active allowed window are saved under the app data dir and logged",
          "only at autonomy 3 or more; a visible indicator is shown while active"
        ]
      },
      "tags": ["desktop"]
    },
    {
      "id": "cloudflare",
      "kind": "capability",
      "name": "cloudflare",
      "description": "Cloudflare deploys (Workers, Pages, DNS) with a token scoped to named zones and Workers.",
      "version": "1.0.0",
      "module": "@forerunner/capabilities/cloudflare",
      "permissions": {
        "tools": [
          "cloudflare_plan",
          "cloudflare_deploy",
          "cloudflare_dns_upsert",
          "cloudflare_verify_token"
        ],
        "actionClasses": ["read", "deploy_staging", "deploy_production"],
        "domains": ["api.cloudflare.com"],
        "paths": [],
        "secrets": ["cloudflare_api_token"],
        "scopes": [
          "plan and deploy Workers and Pages to the zones named in the project settings",
          "upsert DNS records in those zones (a production action)",
          "paid resources and plan changes always ask a human"
        ]
      },
      "tags": ["deploy"]
    },
    {
      "id": "voice-deepgram",
      "kind": "capability",
      "name": "voice-deepgram",
      "description": "Cloud STT through Deepgram for the lowest latency.",
      "version": "1.0.0",
      "module": "@forerunner/voice/deepgram",
      "voice": {
        "stt": ["deepgram"]
      },
      "permissions": {
        "tools": [],
        "actionClasses": ["read"],
        "domains": ["api.deepgram.com"],
        "paths": [],
        "secrets": ["deepgram_api_key"],
        "scopes": ["send voice audio to Deepgram for transcription"]
      },
      "tags": ["voice"]
    },
    {
      "id": "voice-cartesia",
      "kind": "capability",
      "name": "voice-cartesia",
      "description": "Cloud TTS through Cartesia.",
      "version": "1.0.0",
      "module": "@forerunner/voice/cartesia",
      "voice": {
        "tts": ["cartesia"]
      },
      "permissions": {
        "tools": [],
        "actionClasses": ["read"],
        "domains": ["api.cartesia.ai"],
        "paths": [],
        "secrets": ["cartesia_api_key"],
        "scopes": ["send summary text to Cartesia for speech"]
      },
      "tags": ["voice"]
    },
    {
      "id": "voice-elevenlabs",
      "kind": "capability",
      "name": "voice-elevenlabs",
      "description": "Cloud TTS through ElevenLabs.",
      "version": "1.0.0",
      "module": "@forerunner/voice/elevenlabs",
      "voice": {
        "tts": ["elevenlabs"]
      },
      "permissions": {
        "tools": [],
        "actionClasses": ["read"],
        "domains": ["api.elevenlabs.io"],
        "paths": [],
        "secrets": ["elevenlabs_api_key"],
        "scopes": ["send summary text to ElevenLabs for speech"]
      },
      "tags": ["voice"]
    },
    {
      "id": "mcp-filesystem",
      "kind": "connector",
      "name": "filesystem",
      "description": "Reference MCP filesystem server. Add the directories it may see as arguments; the runtime still checks every path against the run token.",
      "version": "latest",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem"],
        "env": {}
      },
      "permissions": {
        "tools": [],
        "actionClasses": [],
        "domains": [],
        "paths": [],
        "secrets": [],
        "scopes": []
      },
      "tags": ["files"]
    },
    {
      "id": "mcp-fetch",
      "kind": "connector",
      "name": "fetch",
      "description": "Reference MCP fetch server: reads web pages as markdown. Domains are limited by the run token's allowlist.",
      "version": "latest",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
      "transport": {
        "type": "stdio",
        "command": "uvx",
        "args": ["mcp-server-fetch"],
        "env": {}
      },
      "permissions": {
        "tools": [],
        "actionClasses": [],
        "domains": [],
        "paths": [],
        "secrets": [],
        "scopes": []
      },
      "tags": ["web"]
    },
    {
      "id": "mcp-github",
      "kind": "connector",
      "name": "github",
      "description": "Extra GitHub tools for agents (issues, PRs, search); the built-in GitHub features do not need it. Runs the GitHub MCP server with the fine-grained token stored in the vault as github_token, the name fr setup --github-token stores (scoped to the repositories you select).",
      "version": "latest",
      "homepage": "https://github.com/github/github-mcp-server",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "secret:github_token"
        }
      },
      "permissions": {
        "tools": [],
        "actionClasses": [],
        "domains": ["api.github.com"],
        "paths": [],
        "secrets": ["github_token"],
        "scopes": ["the token's repository scopes"]
      },
      "tags": ["git"]
    }
  ]
}
