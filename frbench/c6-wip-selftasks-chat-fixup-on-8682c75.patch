+/**
+ * One change as chat's read-back names it: the suggestion card's words (`proposalLine`), except
+ * that an edit says the fields it changes, as task.update's own read-back does ('Change "Publish
+ * the page": priority to High.'); a new title alone stays 'Rename "X" to "Y".'. Before, any edit
+ * without a new title read 'Reword "X".', so a Yes to a "reword" changed a priority (review of
+ * d1109-selftasks-chat; design section 3.9 and section 5 rules 4 and 9).
+ */
+export function fixChangeLine(f: FencedChange): string {
+  const c = f.change;
+  if (c.kind !== "edit") return proposalLine(f);
+  const parts: string[] = [];
+  if (c.title) parts.push(`the title to "${c.title.trim()}"`);
+  if (c.outcome) parts.push("what done looks like");
+  if (c.acceptanceCriteria) parts.push("the criteria");
+  if (c.priority) parts.push(`priority to ${PRIORITY_LABELS[c.priority]}`);
+  if (parts.length === 0 || (c.title && parts.length === 1)) return proposalLine(f);
+  const list =
+    parts.length === 1 ? parts[0] : `${parts.slice(0, -1).join(", ")} and ${parts.at(-1)}`;
+  return `Change "${c.task.trim()}": ${list}.`;
+}
