{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "testenv/src/**/*.ts",
    "testenv/test/**/*.ts",
    "evals/src/**/*.ts",
    "evals/test/**/*.ts",
    "tests/e2e/src/**/*.ts",
    "tests/e2e/scenarios/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
