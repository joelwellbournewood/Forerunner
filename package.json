{
  "name": "forerunner",
  "private": true,
  "version": "0.1.0",
  "description": "Forerunner: a persistent AI project manager per person, with shared projects, hard budgets and an independent critic.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:paths": "node scripts/check-paths.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && pnpm -r --filter \"./apps/*\" --if-present typecheck",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:links": "node scripts/link-check.mjs",
    "docs:schema": "tsx packages/state/scripts/generate-data-model-doc.ts",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "gates:verify": "tsx scripts/gates-verify.ts",
    "check": "pnpm lint && pnpm lint:paths && pnpm typecheck && pnpm test && pnpm docs:check && pnpm docs:links && pnpm secrets:scan",
    "state-api": "tsx services/state-api/src/main.ts",
    "runner": "tsx services/cloud-runner/src/main.ts",
    "fr": "tsx packages/runtime/src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@forerunner/platform": "workspace:*",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
